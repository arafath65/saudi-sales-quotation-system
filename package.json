
{
  "name": "sales-quotation-system",
  "version": "0.1.3",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "desktop": "electron .",
    "icon:build": "node scripts/make-icon.cjs",
    "desktop:prepare": "npm run build && node scripts/prepare-desktop.cjs",
    "desktop:dist": "npm run icon:build && npm run desktop:prepare && electron-builder --win nsis"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.7",
    "gsap": "^3.15.0",
    "next": "16.4.0",
    "postcss": "^8.5.29",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "png-to-ico": "^3.0.2",
    "prisma": "^7.10.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.aiglobal.salesquotation",
    "productName": "Sales Quotation System",
    "electronFuses": {
      "runAsNode": true
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "node_modules/dotenv/**/*"
    ],
    
"extraResources": [
  {
    "from": "desktop-runtime",
    "to": "desktop-runtime",
    "filter": [
      "**/*",
      "!node_modules/**"
    ]
  },
  {
    "from": "desktop-runtime/node_modules",
    "to": "desktop-runtime/node_modules",
    "filter": [
      "**/*"
    ]
  }
],
    "win": {
      "icon": "electron/saudi-sales-quotation.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sales Quotation System",
      "installerIcon": "electron/saudi-sales-quotation.ico",
      "uninstallerIcon": "electron/saudi-sales-quotation.ico",
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "Sales Quotation System Setup ${version}.${ext}"
  }
}
